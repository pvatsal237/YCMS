generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  COORDINATOR
  MEMBER
}

enum EventStatus {
  DRAFT
  PUBLISHED
  REGISTRATION_CLOSED
  COMPLETED
  CANCELLED
}

enum RegistrationType {
  NORMAL
  WALK_IN
}

enum RegistrationStatus {
  REGISTERED
  WAITLISTED
  CANCELLED
}

enum CheckInStatus {
  CHECKED_IN
  NO_SHOW
}

enum GuidanceCategory {
  IMMIGRATION
  CAREER_DEVELOPMENT
  RESUME_INTERVIEW
  TECHNOLOGY_IT
  AI
  FINANCE
  ENGINEERING
  EDUCATION
  ENTREPRENEURSHIP
  OTHER
}

enum GuidanceStatus {
  NEW
  CLAIMED
  WAITING_FOR_MEMBER
  RESOLVED
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  image         String?
  role          UserRole
  active        Boolean   @default(true)
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  memberId      String?   @unique
  member        Member?   @relation("MemberLoginUser", fields: [memberId], references: [id], onDelete: SetNull)

  eventsCreated       Event[]              @relation("EventCreatedBy")
  checkInsPerformed   EventCheckIn[]       @relation("CheckInBy")
  guidanceAssigned    GuidanceRequest[]    @relation("GuidanceAssignedTo")
  guidanceMessages    GuidanceMessage[]
  notifications       Notification[]
  coordinatorAllowlist CoordinatorAllowlist?

  @@index([role, active])
}

model CoordinatorAllowlist {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  userId    String?  @unique
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
}

model Member {
  id                String   @id @default(cuid())
  firstName         String
  lastName          String
  email             String   @unique
  image             String?
  phone             String?
  emergencyName     String?
  emergencyPhone    String?
  emergencyRelation String?
  active            Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  loginUser         User?    @relation("MemberLoginUser")

  registrations EventRegistration[]
  checkIns      EventCheckIn[]
  guidance      GuidanceRequest[]
  feedback      EventFeedback[]

  @@index([lastName, firstName])
  @@index([active])
}

model Event {
  id                   String      @id @default(cuid())
  title                String
  description          String
  speakerName          String?
  speakerTitle         String?
  speakerOrganization  String?
  eventDate            DateTime    @db.Date
  startTime            String
  endTime              String
  location             String
  capacity             Int
  registrationDeadline DateTime
  walkInCapacity       Int         @default(10)
  checkInOpensAt       String      @default("08:00")
  status               EventStatus @default(DRAFT)
  walkInToken          String      @unique
  internalNotes        String?
  reminderSentAt       DateTime?
  createdById          String?
  createdBy            User?       @relation("EventCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  registrations EventRegistration[]
  checkIns      EventCheckIn[]
  feedback      EventFeedback[]

  @@index([status, eventDate])
  @@index([eventDate])
}

model EventRegistration {
  id               String             @id @default(cuid())
  eventId          String
  event            Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  memberId         String
  member           Member             @relation(fields: [memberId], references: [id], onDelete: Cascade)
  type             RegistrationType   @default(NORMAL)
  status           RegistrationStatus @default(REGISTERED)
  waitlistPosition Int?
  promotedAt       DateTime?
  cancelledAt      DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@unique([eventId, memberId])
  @@index([eventId, status])
  @@index([memberId, status])
}

model EventCheckIn {
  id              String        @id @default(cuid())
  eventId         String
  event           Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  memberId        String
  member          Member        @relation(fields: [memberId], references: [id], onDelete: Cascade)
  checkedInAt     DateTime      @default(now())
  checkedInById   String?
  checkedInBy     User?         @relation("CheckInBy", fields: [checkedInById], references: [id], onDelete: SetNull)
  status          CheckInStatus @default(CHECKED_IN)

  @@unique([eventId, memberId])
  @@index([eventId])
}

model GuidanceRequest {
  id             String           @id @default(cuid())
  memberId       String
  member         Member           @relation(fields: [memberId], references: [id], onDelete: Cascade)
  category       GuidanceCategory
  otherTopic     String?
  message        String
  status         GuidanceStatus   @default(NEW)
  assignedToId   String?
  assignedTo     User?            @relation("GuidanceAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)
  claimedAt      DateTime?
  resolvedAt     DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  messages       GuidanceMessage[]

  @@index([status, createdAt])
  @@index([assignedToId, status])
  @@index([memberId, createdAt])
}

model GuidanceMessage {
  id        String          @id @default(cuid())
  requestId String
  request   GuidanceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  authorId  String
  author    User            @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime        @default(now())

  @@index([requestId, createdAt])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String
  href      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([userId, readAt])
}

model EventFeedback {
  id        String   @id @default(cuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  memberId  String
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  rating    Int
  comment   String?
  createdAt DateTime @default(now())

  @@unique([eventId, memberId])
}

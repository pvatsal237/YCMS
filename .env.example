# PostgreSQL connection used by Prisma
DATABASE_URL="postgresql://ycms:ycms_dev_password@localhost:5432/ycms?schema=public"

# Auth.js. Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"
AUTH_URL="http://localhost:3000"

# Optional SMTP for OTP and notices. If omitted locally, email is logged to the console (OTP body is not printed unless DEV_SHOW_OTP=true).
# SMTP_HOST="smtp.example.com"
# SMTP_PORT="587"
# SMTP_SECURE="false"
# SMTP_USER=""
# SMTP_PASSWORD=""
# SMTP_FROM="IYCM <no-reply@iycm.local>"

# Local only. Never enable in production. Shows the OTP on the login page.
# DEV_SHOW_OTP="true"

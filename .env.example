# PostgreSQL connection used by Prisma
DATABASE_URL="postgresql://ycms:ycms_dev_password@localhost:5432/ycms?schema=public"

# Auth.js (next-auth v5). Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"
AUTH_URL="http://localhost:3000"

# Optional SMTP for member OTP emails. If omitted, codes are printed in the server console.
# SMTP_HOST="smtp.example.com"
# SMTP_PORT="587"
# SMTP_SECURE="false"
# SMTP_USER=""
# SMTP_PASSWORD=""
# SMTP_FROM="YCMS <no-reply@ycms.local>"

# Development only: show the OTP on the member login page after requesting a code.
# DEV_SHOW_OTP="true"

# Google Sign-In (Auth.js). Create an OAuth client in Google Cloud Console.
# Authorized redirect URI: {AUTH_URL}/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""


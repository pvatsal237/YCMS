# PostgreSQL connection used by Prisma
# Local/Docker: keep this localhost URL in .env / .env.local
# Production (Vercel): set DATABASE_URL in the Vercel project to a hosted Postgres URL (Neon/Supabase/Vercel Postgres). Use the pooled URL and sslmode=require, e.g. ?sslmode=require&pgbouncer=true
DATABASE_URL="postgresql://ycms:ycms_dev_password@localhost:5432/ycms?schema=public"

# Auth.js (next-auth v5). Generate with: openssl rand -base64 32
# Production: set AUTH_SECRET in Vercel (required). AUTH_URL must be the live https://*.vercel.app (or custom domain).
AUTH_SECRET="replace-with-a-long-random-string"
AUTH_URL="http://localhost:3000"

# Optional SMTP for member OTP emails. If omitted, codes are printed in the server console.
# SMTP_HOST="smtp.example.com"
# SMTP_PORT="587"
# SMTP_SECURE="false"
# SMTP_USER=""
# SMTP_PASSWORD=""
# SMTP_FROM="YCMS <no-reply@ycms.local>"

# Development only: show the OTP on the member login page after requesting a code.
# DEV_SHOW_OTP="true"
